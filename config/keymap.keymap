#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    combos {
        compatible = "zmk,combos";

        bt_clear {
            bindings = <&bt BT_CLR>;
            key-positions = <28 29>;
            layers = <2>;
        };

        henkan {
            bindings = <&kp DOLLAR>;
            key-positions = <33 34>;
        };

        muhenkan {
            bindings = <&kp INT_MUHENKAN>;
            key-positions = <28 27>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <
&kp ESC    &kp N1            &kp N2       &kp N3            &kp N4        &kp N5                                  &kp N6       &kp N7    &kp N8    &kp N9     &kp N0                 &kp BSPC
&kp TAB    &kp Q             &kp L        &kp U             &kp MINUS     &mkp MB2                                &kp F        &kp W     &kp R     &kp Y      &kp P                  &kp BSPC
&kp CAPS   &kp E             &kp I        &kp A             &kp O         &mkp MB1  &mkp LCLK    &mkp RCLK        &kp K        &kp T     &kp N     &kp S      &mt LEFT_ALT H         &kp SQT
&kp LSHFT  &mt LEFT_SHIFT Z  &kp X        &kp C             &kp V         &mkp MB3  &kp A        &kp MINUS        &kp G        &kp D     &kp M     &kp J      &lt 3 B                &kp RSHFT
&kp LCTRL  &mt LCTRL F10     &mt LGUI F7  &mt LALT AT_SIGN  &lt 3 ESCAPE  &lt 2 F2  &lt 1 SPACE  &lt 1 BACKSPACE  &lt 2 ENTER  &kp BSPC  &kp RALT  &kp COMMA  &mt LEFT_SHIFT PERIOD  &kp RCTRL
            >;
        };

        layer_1 {
            bindings = <
&trans  &trans                    &trans             &trans                &trans    &trans                                                   &trans        &trans        &trans        &trans        &trans      &trans
&trans  &kp AMPERSAND             &kp DOUBLE_QUOTES  &kp LEFT_PARENTHESIS  &kp UP    &kp RIGHT_PARENTHESIS                                    &kp MINUS     &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp SLASH   &trans
&trans  &kp LT                    &kp GT             &kp LEFT_ARROW        &kp DOWN  &kp RIGHT              &trans             &trans         &kp PLUS      &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp ASTRK   &trans
&trans  &mt LEFT_SHIFT SEMICOLON  &kp COLON          &kp LG(SLASH)         &kp LBKT  &kp RBKT               &kp F4             &kp EQUAL      &kp NUMBER_0  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp DELETE  &trans
&trans  &trans                    &trans             &trans                &trans    &kp LC(MINUS)          &kp LC(LS(EQUAL))  &kp BACKSPACE  &kp TAB       &trans        &trans        &trans        &trans      &trans
            >;
        };

        layer_2 {
            bindings = <
&trans  &trans                      &trans            &trans        &trans         &trans                              &trans          &trans   &trans  &trans  &trans   &trans
&trans  &kp CARET                   &kp SINGLE_QUOTE  &kp LC(HOME)  &kp PAGE_UP    &kp LC(END)                         &kp LS(N6)      &kp F7   &kp F8  &kp F9  &kp F12  &trans
&trans  &kp N1                      &kp N2            &kp HOME      &kp PAGE_DOWN  &kp END      &trans  &trans         &kp LEFT_BRACE  &kp F4   &kp F5  &kp F6  &kp F11  &trans
&trans  &mt LEFT_SHIFT EXCLAMATION  &kp QUESTION      &kp HASH      &kp DOLLAR     &kp PERCENT  &trans  &trans         &kp LS(MINUS)   &kp F1   &kp F2  &kp F3  &kp F10  &trans
&trans  &kp INT_YEN                 &kp BACKSLASH     &trans        &trans         &trans       &trans  &kp LC(ENTER)  &kp TAB         &kp DEL  &trans  &trans  &trans   &trans
            >;
        };

        layer_3 {
            bindings = <
&trans  &trans            &trans            &trans            &trans            &trans                                     &trans            &trans            &trans            &trans            &trans            &trans
&trans  &kp LG(TAB)       &kp LA(TAB)       &kp LG(LC(LEFT))  &kp LG(UP)        &kp LC(LG(RIGHT))                          &kp LG(NUMBER_1)  &kp LG(NUMBER_2)  &kp LG(NUMBER_3)  &kp LG(NUMBER_4)  &kp LG(NUMBER_5)  &trans
&trans  &kp F6            &kp F7            &kp LG(LEFT)      &kp LG(DOWN)      &kp LG(RIGHT)      &trans       &trans     &kp LG(E)         &kp LC(P)         &kp LC(EQUAL)     &kp LC(NUMBER_0)  &kp LC(MINUS)     &trans
&trans  &kp LA(NUMBER_1)  &kp LA(NUMBER_2)  &kp LA(NUMBER_3)  &kp LA(NUMBER_4)  &kp LG(LS(RIGHT))  &kp LC(S)    &trans     &kp LC(Z)         &kp LA(UP_ARROW)  &kp LA(LEFT)      &kp LA(RIGHT)     &kp PIPE          &trans
&trans  &bt BT_SEL 0      &bt BT_SEL 1      &trans            &kp LC(W)         &kp LC(LS(TAB))    &kp LC(TAB)  &kp LG(L)  &kp LA(F4)        &trans            &trans            &trans            &kp LG(L)         &trans
            >;
        };
    };
};
